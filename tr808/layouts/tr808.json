{
  "id": "root",
  "type": "row",
  "theme": "tr808",
  "ui_font": "Helvetica Neue",
  "preview": "layouts/tr808.svg",
  "titlebar": "none",
  "traffic_lights": [20, 10],
  "background": { "gradient": ["#0a0a0a", "#202020"], "angle": 90 },
  "padding": [0, 8],
  "terminal_padding": [14, 12],
  "children": [
    {
      "id": "chassis",
      "type": "row",
      "background": "canvas",
      "border": { "width": 1, "color": "#000000" },
      "divider": { "width": 1, "color": "dim" },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": { "px": 268 },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false,
          "children": [
            {
              "id": "brand",
              "type": "block",
              "size": { "px": 46 },
              "window_drag": true,
              "content": { "mod": "tr808", "props": { "part": "brand" } }
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                { "id": "spaces", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "tr808-spaces", "props": { "look": "808" } } },
                { "id": "agents", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "tr808-agents" } }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": { "px": 28 },
              "content": { "mod": "tr808", "props": { "part": "footer" } }
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": { "px": 46 },
              "window_drag": true,
              "content": { "mod": "tr808", "props": { "part": "tabs" } }
            },
            {
              "id": "work-body",
              "type": "row",
              "padding": 8,
              "gap": 8,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": { "mod": "tr808" },
                        "reveal": "always",
                        "height": 28,
                        "position": "top"
                      },
                      "background": "background",
                      "border": { "width": 1, "color": "border" },
                      "focus": { "width": 1, "color": "accent" },
                      "radius": 3,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "size": { "px": 368 },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        { "id": "files", "type": "block", "content": { "mod": "files" } },
                        { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "status",
              "type": "block",
              "size": { "px": 28 },
              "content": { "mod": "tr808", "props": { "part": "status" } }
            }
          ]
        }
      ]
    }
  ]
}
